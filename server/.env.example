# ---- AI provider ----
# Get a free key at https://aistudio.google.com (Get API key). Paste it below.
# With no key the app runs in DEMO MODE (simple word rules, not real AI).
GEMINI_API_KEY=
# Model to use. Flash-Lite has the most generous free quota. Check the current list in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative: Groq (https://console.groq.com). Used when AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# gemini | groq | demo. Leave empty to pick automatically from the keys above.
AI_PROVIDER=

# ---- Storage ----
# Optional. Without it, documents are saved in server/data/documents.json.
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/humanize-ai
MONGO_URI=

# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Limits (keep a public demo inside the free quota) ----
MAX_TEXT_WORDS=1500
MAX_SUMMARY_WORDS=6000
MAX_DOC_WORDS=15000
MAX_DOC_MB=10
RATE_LIMIT_REQUESTS=40
RATE_LIMIT_WINDOW_MIN=10
